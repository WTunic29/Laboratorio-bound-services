<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bound Services - Odómetro"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Distancia recorrida"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/distanceTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0.0 m"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="16dp" />

        <TextView
            android:id="@+id/locationTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubicación: pendiente"
            android:textSize="14sp"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuración"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/precisionEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Precisión del movimiento (metros)"
            android:inputType="numberDecimal"
            android:text="5" />

        <EditText
            android:id="@+id/intervalEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tiempo de actualización (segundos)"
            android:inputType="number"
            android:text="5" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INICIAR REGISTRO"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DETENER REGISTRO" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Historial de recorridos"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#49454F"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/historialTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Todavía no hay recorridos registrados."
            android:textSize="14sp"
            android:textColor="#49454F"
            android:padding="12dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reporte consolidado"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#49454F"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/reporteTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sin información disponible."
            android:textSize="14sp"
            android:textColor="#49454F"
            android:padding="12dp" />

    </LinearLayout>

</ScrollView>
